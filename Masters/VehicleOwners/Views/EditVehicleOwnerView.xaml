<UserControl x:Class="veteran_logistic.Masters.VehicleOwners.Views.EditVehicleOwnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <TextBlock Text="Edit Vehicle Owner"
                       Style="{StaticResource HeadingTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Large}">
            <StackPanel>
                <!-- Validation Error -->
                <Border Background="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Owner Code (Read Only) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Owner Code"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OwnerCode}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource DisabledBrush}" />
                    </Grid>
                </Border>

                <!-- Main Form Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: PAN Type, PAN Number -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PAN Type"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding PANTypes}"
                                  SelectedItem="{Binding PANType}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="PAN Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding PANNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 2: First Name, Middle Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="First Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Middle Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 3: Last Name, Company Name -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Company Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 4: City, State -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="City"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="State"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Text="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 5: Phone, Mobile -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Mobile"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="4"
                                 Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 6: Email, Fax -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Email"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Fax"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="4"
                                 Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />
                    </Grid>
                </Border>

                <!-- Address Field -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Address"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Top"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="{StaticResource ExtraSmall}"
                                 VerticalScrollBarVisibility="Auto" />

                        <CheckBox Grid.Column="3"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center"
                                  Margin="{StaticResource ExtraSmall}" />
                        <TextBlock Grid.Column="4" Text="Active"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Small}" />
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{StaticResource Medium}">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />
                </StackPanel>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar Height="{StaticResource StandardControlHeight}"
                                   IsIndeterminate="True"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="{StaticResource Small}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
