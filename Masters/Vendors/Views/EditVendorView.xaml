<UserControl x:Class="veteran_logistic.Masters.Vendors.Views.EditVendorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <TextBlock Text="Edit Vendor"
                       Style="{StaticResource HeadingTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Large}">
            <StackPanel>
                <!-- Validation Error -->
                <Border Background="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Main Form Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Code (Auto-generated), Type -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Code (Auto-generated)"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 IsReadOnly="True" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Type"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="0" Grid.Column="4"
                                  SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}">
                            <ComboBoxItem Content="Union" />
                            <ComboBoxItem Content="Vendor" />
                        </ComboBox>

                        <!-- Row 2: Name, Correspondence Address -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Correspondence Address"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding CorrespondenceAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 3: City, Billing Address -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="City"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Billing Address"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 4: Phone, Mobile -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Phone"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Mobile"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 5: Fax, Email -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fax"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Email"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="4"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 6: Service Tax, CST -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Service Tax"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding ServiceTax, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="5" Grid.Column="3" Text="CST"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="4"
                                 Text="{Binding CST, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 7: PAN, GSTIN -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="PAN"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding PAN, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="6" Grid.Column="3" Text="GSTIN"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="6" Grid.Column="4"
                                 Text="{Binding GSTIN, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />
                    </Grid>
                </Border>

                <!-- Active & Buttons -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center"
                                  Margin="{StaticResource ExtraSmall}" />
                        <TextBlock Grid.Column="1" Text="Active"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Small}" />

                        <Button Grid.Column="3" Content="Save"
                                Command="{Binding SaveCommand}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}"
                                MinWidth="100" />

                        <Button Grid.Column="4" Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}"
                                MinWidth="100" />
                    </Grid>
                </Border>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar Height="{StaticResource StandardControlHeight}"
                                   IsIndeterminate="True"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="{StaticResource Small}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
