<UserControl x:Class="veteran_logistic.Masters.DORates.Views.EditDORateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <TextBlock Text="Edit DO Rate"
                       Style="{StaticResource HeadingTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Large}">
            <StackPanel>
                <!-- Validation Error -->
                <Border Background="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Main Form Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Consignor, Consignee -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Consignor"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Consignors}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ConsignorId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Name" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Consignee"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="0" Grid.Column="4"
                                  ItemsSource="{Binding Consignees}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ConsigneeId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Name" />

                        <!-- Row 2: Source, Destination -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding SourceDestinations}"
                                  DisplayMemberPath="LocationName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SourceId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="LocationName" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Destination"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="1" Grid.Column="4"
                                  ItemsSource="{Binding SourceDestinations}"
                                  DisplayMemberPath="LocationName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding DestinationId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="LocationName" />

                        <!-- Row 3: Effective Date, DO Number -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Effective Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <DatePicker Grid.Row="2" Grid.Column="1"
                                    SelectedDate="{Binding EffectiveDate}"
                                    Height="{StaticResource StandardControlHeight}"
                                    Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="DO Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding DONumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 4: DO Qty, Freight Rate -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DO Qty"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding DOQty, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Freight Rate"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Text="{Binding FreightRate, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 5: Union Rate, Vendor Rate -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Union Rate"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding UnionRate, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Vendor Rate"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="4" Grid.Column="4"
                                 Text="{Binding VendorRate, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 6: Billing Rate, Allowed Shortage -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Billing Rate"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding BillingRate, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Allowed Shortage"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="5" Grid.Column="4"
                                 Text="{Binding AllowedShortage, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 7: Rate Per Kg, Vessel Name -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Rate Per Kg"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding RatePerKg, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="6" Grid.Column="3" Text="Vessel Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="6" Grid.Column="4"
                                 Text="{Binding VesselName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 8: Trader Name, Active -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Trader Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="7" Grid.Column="1"
                                 Text="{Binding TraderName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <CheckBox Grid.Row="7" Grid.Column="3"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center"
                                  Margin="{StaticResource ExtraSmall}" />
                        <TextBlock Grid.Row="7" Grid.Column="4" Text="Active"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Small}" />
                    </Grid>
                </Border>

                <!-- Narration -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Narration"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Top"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="{StaticResource ExtraSmall}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{StaticResource Medium}">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />
                </StackPanel>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar Height="{StaticResource StandardControlHeight}"
                                   IsIndeterminate="True"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="{StaticResource Small}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
