<UserControl x:Class="veteran_logistic.Reports.QueryBuilder.Views.QueryBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:veteran_logistic.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Query Builder"
                           Style="{StaticResource HeadingTextBlockStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Back Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Go Back"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource BackIconGeometry}"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <!-- Export to PDF Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to PDF"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export PDF"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Export to Excel Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to Excel"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export Excel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Export to CSV Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToCsvCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to CSV"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export CSV"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Print Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Print"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Print"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module Selection -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Module:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableModules}"
                          SelectedItem="{Binding SelectedModule}"
                          DisplayMemberPath="DisplayName"
                          Width="200"
                          Margin="{StaticResource Small}"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                           Text="{Binding ValidationMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="Red"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Column Selection -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Column Selection" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Available Columns -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Available Columns"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        <ListBox ItemsSource="{Binding AvailableColumns}"
                                 SelectedItem="{Binding SelectedAvailableColumn}"
                                 DisplayMemberPath="DisplayName"
                                 Height="150"
                                 Margin="{StaticResource Small}" />
                    </StackPanel>

                    <!-- Column Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="{StaticResource Medium}">
                        <Button Content="Add →"
                                Command="{Binding AddColumnCommand}"
                                Width="80"
                                Height="30"
                                Margin="{StaticResource Small}" />
                        <Button Content="← Remove"
                                Command="{Binding RemoveColumnCommand}"
                                Width="80"
                                Height="30"
                                Margin="{StaticResource Small}" />
                        <Button Content="▲ Up"
                                Command="{Binding MoveColumnUpCommand}"
                                Width="80"
                                Height="30"
                                Margin="{StaticResource Small}" />
                        <Button Content="▼ Down"
                                Command="{Binding MoveColumnDownCommand}"
                                Width="80"
                                Height="30"
                                Margin="{StaticResource Small}" />
                    </StackPanel>

                    <!-- Selected Columns -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Selected Columns"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        <ListBox ItemsSource="{Binding SelectedColumns}"
                                 SelectedItem="{Binding SelectedSelectedColumn}"
                                 DisplayMemberPath="DisplayName"
                                 Height="150"
                                 Margin="{StaticResource Small}" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Filter Builder -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Filters" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter List -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding SelectedFilter}"
                              AutoGenerateColumns="False"
                              Height="120"
                              Margin="{StaticResource Small}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding FieldId}" Width="*" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="120" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="{StaticResource Small}">
                        <Button Content="Add Filter"
                                Command="{Binding AddFilterCommand}"
                                Width="100"
                                Height="30"
                                Margin="{StaticResource Small}" />
                        <Button Content="Remove Filter"
                                Command="{Binding RemoveFilterCommand}"
                                Width="120"
                                Height="30"
                                Margin="{StaticResource Small}" />
                        <Button Content="Clear All"
                                Command="{Binding ClearFiltersCommand}"
                                Width="100"
                                Height="30"
                                Margin="{StaticResource Small}" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Sort, Group, and Aggregate -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Sorting, Grouping &amp; Aggregates" IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sorting -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sorting"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        <DataGrid ItemsSource="{Binding Sorts}"
                                  SelectedItem="{Binding SelectedSort}"
                                  AutoGenerateColumns="False"
                                  Height="100"
                                  Margin="{StaticResource Small}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding FieldId}" Width="*" />
                                <DataGridCheckBoxColumn Header="Asc" Binding="{Binding Ascending}" Width="50" />
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Small}">
                            <Button Content="Add" Command="{Binding AddSortCommand}" Width="60" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="Remove" Command="{Binding RemoveSortCommand}" Width="70" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="▲" Command="{Binding MoveSortUpCommand}" Width="40" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="▼" Command="{Binding MoveSortDownCommand}" Width="40" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="Clear" Command="{Binding ClearSortsCommand}" Width="60" Height="25" Margin="{StaticResource Small}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Grouping -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Grouping"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        <ComboBox ItemsSource="{Binding AvailableColumns}"
                                  SelectedItem="{Binding SelectedGroupField}"
                                  DisplayMemberPath="DisplayName"
                                  Height="30"
                                  Margin="{StaticResource Small}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Small}">
                            <Button Content="Clear Group"
                                    Command="{Binding ClearGroupingCommand}"
                                    Width="100"
                                    Height="25"
                                    Margin="{StaticResource Small}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Aggregates -->
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="Aggregates"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        <DataGrid ItemsSource="{Binding Aggregates}"
                                  SelectedItem="{Binding SelectedAggregate}"
                                  AutoGenerateColumns="False"
                                  Height="100"
                                  Margin="{StaticResource Small}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding FieldId}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AggregateType}" Width="80" />
                                <DataGridTextColumn Header="Display" Binding="{Binding DisplayName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Small}">
                            <Button Content="Add" Command="{Binding AddAggregateCommand}" Width="60" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="Remove" Command="{Binding RemoveAggregateCommand}" Width="70" Height="25" Margin="{StaticResource Small}" />
                            <Button Content="Clear" Command="{Binding ClearAggregatesCommand}" Width="60" Height="25" Margin="{StaticResource Small}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Search and Execute -->
        <Border Grid.Row="5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="{StaticResource StandardControlHeight}"
                         Margin="{StaticResource Small}"
                         VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Content="Execute Query"
                        Command="{Binding ExecuteQueryCommand}"
                        Width="120"
                        Height="{StaticResource StandardControlHeight}"
                        Margin="{StaticResource Small}"
                        VerticalAlignment="Center" />

                <Button Grid.Column="3"
                        Content="Reset"
                        Command="{Binding ResetQueryCommand}"
                        Width="80"
                        Height="{StaticResource StandardControlHeight}"
                        Margin="{StaticResource Small}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Results Grid -->
        <Border Grid.Row="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Results"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <DataGrid Grid.Row="1"
                          x:Name="ResultsDataGrid"
                          ItemsSource="{Binding ResultItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Margin="{StaticResource Small}"
                          LoadingRow="ResultsDataGrid_LoadingRow" />

                <!-- Busy Indicator -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        Opacity="0.8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Executing query..."
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True"
                                   Width="200"
                                   Height="20"
                                   Margin="{StaticResource Medium}" />
                    </StackPanel>
                </Border>

                <!-- Result Limit Warning -->
                <Border Grid.Row="1"
                        Background="Orange"
                        Opacity="0.9"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasResultLimitWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Results limited to 10,000 records. Use filters to narrow your search."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,0,0"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding QueryResult.TotalCount, StringFormat='Records: {0}'}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Visibility="{Binding QueryResult, Converter={StaticResource NullToVisibilityConverter}}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding QueryResult.ExecutionTimeMs, StringFormat='Execution Time: {0}ms'}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="{Binding QueryResult, Converter={StaticResource NullToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
