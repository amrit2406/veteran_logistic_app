<UserControl x:Class="veteran_logistic.Reports.ConsolidatedReport.Views.ConsolidatedReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:veteran_logistic.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Consolidated Report"
                           Style="{StaticResource HeadingTextBlockStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Back Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Go Back"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource BackIconGeometry}"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <!-- Export to PDF Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to PDF"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export PDF"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Export to Excel Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to Excel"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export Excel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Refresh Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Refresh"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Cards -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <UniformGrid Columns="5">
                <Border Background="{DynamicResource PrimaryBrush}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource ExtraSmall}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="Total Transactions"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}" />
                        <TextBlock Text="{Binding SummaryCards.TotalTransactions}"
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PrimaryBrush}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource ExtraSmall}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="Loading Only"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}" />
                        <TextBlock Text="{Binding SummaryCards.LoadingOnly}"
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PrimaryBrush}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource ExtraSmall}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="Pending Payment"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}" />
                        <TextBlock Text="{Binding SummaryCards.PendingPayment}"
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PrimaryBrush}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource ExtraSmall}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="Pending Billing"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}" />
                        <TextBlock Text="{Binding SummaryCards.PendingBilling}"
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PrimaryBrush}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource ExtraSmall}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="Completed"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}" />
                        <TextBlock Text="{Binding SummaryCards.Completed}"
                                   Style="{StaticResource HeadingTextBlockStyle}"
                                   Foreground="{DynamicResource TextOnPrimaryBrush}"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Filters" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Date Range -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="From:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="1"
                               SelectedDate="{Binding Filter.DateFrom}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="To:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="3"
                               SelectedDate="{Binding Filter.DateTo}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <!-- Consignor -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Consignor:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                             ItemsSource="{Binding Consignors}"
                             SelectedValue="{Binding Filter.ConsignorId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="CustomerName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="150" />

                    <!-- Consignee -->
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Consignee:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="1" Grid.Column="3"
                             ItemsSource="{Binding Consignees}"
                             SelectedValue="{Binding Filter.ConsigneeId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="CustomerName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="150" />

                    <!-- Source -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Source:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                             ItemsSource="{Binding Sources}"
                             SelectedValue="{Binding Filter.SourceId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="LocationName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="150" />

                    <!-- Destination -->
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="Destination:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="3"
                             ItemsSource="{Binding Destinations}"
                             SelectedValue="{Binding Filter.DestinationId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="LocationName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="150" />

                    <!-- SAR Filter -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="SAR Filter:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                             ItemsSource="{Binding SARFilterOptions}"
                             SelectedItem="{Binding Filter.SARFilter}"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="150" />

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right"
                               Margin="{StaticResource Small}">
                        <Button Content="Apply Filters"
                               Command="{Binding ApplyFiltersCommand}"
                               Margin="{StaticResource Small}"
                               Width="100" />
                        <Button Content="Clear Filters"
                               Command="{Binding ClearFiltersCommand}"
                               Margin="{StaticResource Small}"
                               Width="100" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Search -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />

                <TextBox Grid.Column="1"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="{StaticResource Small}"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="Sort By:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />

                <ComboBox Grid.Column="3"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SortBy}"
                         Margin="{StaticResource Small}"
                         VerticalAlignment="Center"
                         Width="150">
                    <ComboBoxItem Content="Loading Date" Tag="loadingdate" />
                    <ComboBoxItem Content="Unloading Date" Tag="unloadingdate" />
                    <ComboBoxItem Content="Payment Date" Tag="paymentdate" />
                    <ComboBoxItem Content="Bill Date" Tag="billdate" />
                    <ComboBoxItem Content="Vehicle" Tag="vehicle" />
                    <ComboBoxItem Content="Consignor" Tag="consignor" />
                    <ComboBoxItem Content="Consignee" Tag="consignee" />
                    <ComboBoxItem Content="Source" Tag="source" />
                    <ComboBoxItem Content="Destination" Tag="destination" />
                    <ComboBoxItem Content="Bill Number" Tag="billnumber" />
                    <ComboBoxItem Content="Challan Number" Tag="challannumber" />
                    <ComboBoxItem Content="Loading Weight" Tag="loadingweight" />
                    <ComboBoxItem Content="Unloading Weight" Tag="unloadingweight" />
                    <ComboBoxItem Content="Net Payment" Tag="netpayment" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Margin="{StaticResource Small}"
                Padding="{StaticResource Medium}">
            <DataGrid ItemsSource="{Binding ReportItems}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     SelectionMode="Single"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Challan" Binding="{Binding ChallanNumber}" Width="*" />
                    <DataGridTextColumn Header="Loading Date" Binding="{Binding LoadingDate, StringFormat=dd-MM-yyyy}" Width="*" />
                    <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNumber}" Width="*" />
                    <DataGridTextColumn Header="Consignor" Binding="{Binding ConsignorName}" Width="*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="*" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationName}" Width="*" />
                    <DataGridTextColumn Header="Loading Weight" Binding="{Binding LoadingWeight, StringFormat=F2}" Width="*" />
                    <DataGridTextColumn Header="Loading Amount" Binding="{Binding LoadingAmount, StringFormat=F2}" Width="*" />
                    <DataGridTextColumn Header="Unloading Date" Binding="{Binding UnloadingDate, StringFormat=dd-MM-yyyy}" Width="*" />
                    <DataGridTextColumn Header="Unloading Weight" Binding="{Binding UnloadingWeight, StringFormat=F2}" Width="*" />
                    <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate, StringFormat=dd-MM-yyyy}" Width="*" />
                    <DataGridTextColumn Header="Net Payment" Binding="{Binding NetPayment, StringFormat=F2}" Width="*" />
                    <DataGridTextColumn Header="Bill Number" Binding="{Binding BillNumber}" Width="*" />
                    <DataGridTextColumn Header="Lifecycle Status" Binding="{Binding LifecycleStatus}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Totals Panel -->
        <Border Grid.Row="5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Records: "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="0"
                           Text="{Binding Totals.RecordCount}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0" />

                <TextBlock Grid.Column="1"
                           Text="Total Weight: "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Totals.TotalLoadingWeight, StringFormat=F2}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0" />

                <TextBlock Grid.Column="2"
                           Text="Total Amount: "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Totals.TotalLoadingAmount, StringFormat=F2}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0" />

                <TextBlock Grid.Column="3"
                           Text="Total Net Payment: "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Totals.TotalNetPayment, StringFormat=F2}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0" />

                <TextBlock Grid.Column="4"
                           Text="Total TDS: "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="{Binding Totals.TotalTDSAmount, StringFormat=F2}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
