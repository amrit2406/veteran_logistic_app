<UserControl x:Class="veteran_logistic.Reports.LoadingReport.Views.LoadingReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:veteran_logistic.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Loading Report"
                           Style="{StaticResource HeadingTextBlockStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Back Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Go Back"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource BackIconGeometry}"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <!-- Export to PDF Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to PDF"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export PDF"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Export to Excel Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to Excel"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export Excel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Refresh Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Refresh"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Filters" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Date Range -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Date From:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="1"
                               SelectedDate="{Binding Filter.DateFrom}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Date To:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="3"
                               SelectedDate="{Binding Filter.DateTo}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <!-- Consignor -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Consignor:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                             ItemsSource="{Binding Customers}"
                             SelectedValue="{Binding Filter.ConsignorId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="CustomerName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Consignee -->
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Consignee:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="1" Grid.Column="3"
                             ItemsSource="{Binding Customers}"
                             SelectedValue="{Binding Filter.ConsigneeId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="CustomerName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Source -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Source:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                             ItemsSource="{Binding SourceDestinations}"
                             SelectedValue="{Binding Filter.SourceId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="LocationName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Destination -->
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="Destination:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="3"
                             ItemsSource="{Binding SourceDestinations}"
                             SelectedValue="{Binding Filter.DestinationId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="LocationName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Vehicle -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Vehicle:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                             ItemsSource="{Binding Vehicles}"
                             SelectedValue="{Binding Filter.VehicleId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="VehicleNumber"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Material -->
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               Text="Material:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="3" Grid.Column="3"
                             ItemsSource="{Binding Materials}"
                             SelectedValue="{Binding Filter.MaterialId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="MaterialName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="4"
                               Grid.RowSpan="4"
                               Orientation="Vertical"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}">
                        <Button Command="{Binding ApplyFiltersCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}">
                            <TextBlock Text="Apply"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}">
                            <TextBlock Text="Clear"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Search Section -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource Small}"
                         VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource BaseTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Padding" Value="{StaticResource Small}" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <ProgressBar Height="{StaticResource StandardControlHeight}"
                           IsIndeterminate="True"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="{StaticResource Small}" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding ReportItems}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Challan No."
                                    Binding="{Binding ChallanNumber}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Loading Date"
                                    Binding="{Binding LoadingDate, StringFormat=dd-MM-yyyy}"
                                    Width="Auto" />

                <DataGridTextColumn Header="TP Number"
                                    Binding="{Binding TPNumber}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Vehicle No."
                                    Binding="{Binding VehicleNumber}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Consignor"
                                    Binding="{Binding ConsignorName}"
                                    Width="*" />

                <DataGridTextColumn Header="Consignee"
                                    Binding="{Binding ConsigneeName}"
                                    Width="*" />

                <DataGridTextColumn Header="Source"
                                    Binding="{Binding SourceName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Destination"
                                    Binding="{Binding DestinationName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Material"
                                    Binding="{Binding MaterialName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Driver"
                                    Binding="{Binding Driver}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Gross Weight"
                                    Binding="{Binding GrossWeight}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Tare Weight"
                                    Binding="{Binding TareWeight}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Loading Weight"
                                    Binding="{Binding LoadingWeight}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Rate"
                                    Binding="{Binding Rate}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Gross Amount"
                                    Binding="{Binding GrossAmount}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Fuel Amount"
                                    Binding="{Binding FuelAmount}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Cash Advance"
                                    Binding="{Binding CashAdvance}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Other Advance"
                                    Binding="{Binding OtherAdvance}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Payment Location"
                                    Binding="{Binding PaymentLocationName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Union/Vendor"
                                    Binding="{Binding UnionVendorName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Owner"
                                    Binding="{Binding OwnerName}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Active"
                                    Binding="{Binding IsActive}"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals Section -->
        <Border Grid.Row="5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Record Count:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding Totals.RecordCount}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Total Gross Weight:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="{Binding Totals.TotalGrossWeight}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="Total Tare Weight:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="0" Grid.Column="5"
                           Text="{Binding Totals.TotalTareWeight}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="0" Grid.Column="6"
                           Text="Total Loading Weight:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="0" Grid.Column="7"
                           Text="{Binding Totals.TotalLoadingWeight}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Total Gross Amount:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Totals.TotalGrossAmount}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Total Fuel Amount:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="1" Grid.Column="3"
                           Text="{Binding Totals.TotalFuelAmount}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="1" Grid.Column="4"
                           Text="Total Cash Advance:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="1" Grid.Column="5"
                           Text="{Binding Totals.TotalCashAdvance}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />

                <TextBlock Grid.Row="1" Grid.Column="6"
                           Text="Total Other Advance:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="{StaticResource Small}" />
                <TextBlock Grid.Row="1" Grid.Column="7"
                           Text="{Binding Totals.TotalOtherAdvance}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="{StaticResource Small}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
