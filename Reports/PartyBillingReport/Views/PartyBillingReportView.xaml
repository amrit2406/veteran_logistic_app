<UserControl x:Class="veteran_logistic.Reports.PartyBillingReport.Views.PartyBillingReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:veteran_logistic.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Party Wise Billing Report"
                           Style="{StaticResource HeadingTextBlockStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Back Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Go Back"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource BackIconGeometry}"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <!-- Export to PDF Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to PDF"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export PDF"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Export to Excel Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Export to Excel"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Export Excel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Refresh Button -->
                    <Button Height="{StaticResource StandardControlHeight}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh"
                            VerticalAlignment="Center"
                            Margin="{StaticResource Small}">
                        <TextBlock Text="Refresh"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Filters" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bill Date Range -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Bill Date From:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="1"
                               SelectedDate="{Binding Filter.BillDateFrom}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Bill Date To:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="0" Grid.Column="3"
                               SelectedDate="{Binding Filter.BillDateTo}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <!-- Loading Date Range -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Loading Date From:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="1" Grid.Column="1"
                               SelectedDate="{Binding Filter.LoadingDateFrom}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Loading Date To:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <DatePicker Grid.Row="1" Grid.Column="3"
                               SelectedDate="{Binding Filter.LoadingDateTo}"
                               Margin="{StaticResource Small}"
                               VerticalAlignment="Center" />

                    <!-- Customer -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Customer:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                             ItemsSource="{Binding Customers}"
                             SelectedValue="{Binding Filter.CustomerId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="CustomerName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Vehicle -->
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="Vehicle:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="2" Grid.Column="3"
                             ItemsSource="{Binding Vehicles}"
                             SelectedValue="{Binding Filter.VehicleId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="VehicleNumber"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Material -->
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Material:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                             ItemsSource="{Binding Materials}"
                             SelectedValue="{Binding Filter.MaterialId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="MaterialName"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Destination -->
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               Text="Destination:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}" />
                    <ComboBox Grid.Row="3" Grid.Column="3"
                             ItemsSource="{Binding Destinations}"
                             SelectedValue="{Binding Filter.DestinationId}"
                             SelectedValuePath="Id"
                             DisplayMemberPath="Name"
                             Margin="{StaticResource Small}"
                             VerticalAlignment="Center"
                             Width="120" />

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="4"
                               Grid.RowSpan="4"
                               Orientation="Vertical"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Small}">
                        <Button Command="{Binding ApplyFiltersCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}">
                            <TextBlock Text="Apply"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}">
                            <TextBlock Text="Clear"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- Search Section -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search:"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Small}" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource Small}"
                         VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style BasedOn="{StaticResource BaseTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Padding" Value="{StaticResource Small}" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <ProgressBar Height="{StaticResource StandardControlHeight}"
                           IsIndeterminate="True"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="{StaticResource Small}" />
                <TextBlock Text="{Binding BusyMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Summary DataGrid -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding ReportItems}"
                  SelectedItem="{Binding SelectedBill}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bill No."
                                    Binding="{Binding BillNumber}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Bill Date"
                                    Binding="{Binding BillDate, StringFormat=dd-MM-yyyy}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Customer"
                                    Binding="{Binding Customer}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Third Party"
                                    Binding="{Binding ThirdParty}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Permit No."
                                    Binding="{Binding PermitNumber}"
                                    Width="Auto" />

                <DataGridTextColumn Header="From Date"
                                    Binding="{Binding FromDate, StringFormat=dd-MM-yyyy}"
                                    Width="Auto" />

                <DataGridTextColumn Header="To Date"
                                    Binding="{Binding ToDate, StringFormat=dd-MM-yyyy}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Challans"
                                    Binding="{Binding NumberOfChallans}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Total Weight"
                                    Binding="{Binding TotalLoadingWeight, StringFormat=F2}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Total Amount"
                                    Binding="{Binding TotalBillAmount, StringFormat=F2}"
                                    Width="Auto" />

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bill Details Panel -->
        <Border Grid.Row="5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Expander Header="Bill Details" IsExpanded="True"
                      Visibility="{Binding SelectedBill, Converter={StaticResource NullToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding DetailItems}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Challan No."
                                            Binding="{Binding ChallanNumber}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Loading Date"
                                            Binding="{Binding LoadingDate, StringFormat=dd-MM-yyyy}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Vehicle"
                                            Binding="{Binding VehicleNumber}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Material"
                                            Binding="{Binding Material}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Consignor"
                                            Binding="{Binding Consignor}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Consignee"
                                            Binding="{Binding Consignee}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Destination"
                                            Binding="{Binding Destination}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Weight"
                                            Binding="{Binding LoadingWeight, StringFormat=F2}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Rate"
                                            Binding="{Binding Rate, StringFormat=F2}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Gross Amount"
                                            Binding="{Binding GrossAmount, StringFormat=F2}"
                                            Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>

        <!-- Totals Panel -->
        <Border Grid.Row="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}"
                Margin="{StaticResource Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Record Count: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.RecordCount}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Total Bills: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.TotalBills}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Total Challans: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.TotalChallans}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Total Weight: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.TotalLoadingWeight, StringFormat=F2}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Total Amount: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.TotalGrossAmount, StringFormat=F2}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="{StaticResource Small}">
                    <TextBlock Text="Avg Bill: "
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Totals.AverageBillAmount, StringFormat=F2}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
