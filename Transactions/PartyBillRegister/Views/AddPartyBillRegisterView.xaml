<UserControl x:Class="veteran_logistic.Transactions.PartyBillRegister.Views.AddPartyBillRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <TextBlock Text="Add Party Bill Register"
                       Style="{StaticResource HeadingTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Large}">
            <StackPanel>
                <!-- Validation Error -->
                <Border Background="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Header Information Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Bill Number -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bill Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding BillNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 1: Bill Date, Party Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bill Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <DatePicker Grid.Row="1" Grid.Column="1"
                                    SelectedDate="{Binding BillDate}"
                                    Height="{StaticResource StandardControlHeight}"
                                    Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Party Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="1" Grid.Column="4"
                                  ItemsSource="{Binding Customers}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="CustomerName"
                                  SelectedValue="{Binding PartyId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="CustomerName" />

                        <!-- Row 2: Third Party Name, Permit Number -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Third Party Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding ThirdPartyName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Permit Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding PermitNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 3: Consignor, Destination -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Consignor"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding Customers}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="CustomerName"
                                  SelectedValue="{Binding ConsignorId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="CustomerName" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Destination"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="3" Grid.Column="4"
                                  ItemsSource="{Binding SourceDestinations}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="LocationName"
                                  SelectedValue="{Binding DestinationId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="LocationName" />

                        <!-- Row 4: From Date, To Date -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="From Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <DatePicker Grid.Row="4" Grid.Column="1"
                                    SelectedDate="{Binding FromDate}"
                                    Height="{StaticResource StandardControlHeight}"
                                    Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="To Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <DatePicker Grid.Row="4" Grid.Column="4"
                                    SelectedDate="{Binding ToDate}"
                                    Height="{StaticResource StandardControlHeight}"
                                    Margin="{StaticResource ExtraSmall}" />
                    </Grid>
                </Border>

                <!-- Search Button -->
                <Button Content="Search Eligible Loading Registers"
                        Command="{Binding SearchEligibleLoadingRegistersCommand}"
                        Height="{StaticResource StandardControlHeight}"
                        Margin="{StaticResource Small}"
                        HorizontalAlignment="Right"
                        MinWidth="200" />

                <!-- Eligible Loading Registers Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Select All Checkbox -->
                        <CheckBox Grid.Row="0"
                                  IsChecked="{Binding SelectAll}"
                                  Content="Select All"
                                  VerticalAlignment="Center"
                                  Margin="{StaticResource ExtraSmall}" />

                        <!-- Loading Registers DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding EligibleLoadingRegisters}"
                                  AutoGenerateColumns="False"
                                  Height="200"
                                  Margin="{StaticResource ExtraSmall}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select"
                                                       Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                       Width="Auto" />

                                <DataGridTextColumn Header="TP Number"
                                                    Binding="{Binding TPNumber}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Challan Number"
                                                    Binding="{Binding ChallanNumber}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Vehicle Number"
                                                    Binding="{Binding VehicleNumber}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Loading Date"
                                                    Binding="{Binding LoadingDate, StringFormat=dd-MM-yyyy}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Material Weight"
                                                    Binding="{Binding MaterialWeight}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Billing Rate"
                                                    Binding="{Binding BillingRate}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Driver Commission"
                                                    Binding="{Binding DriverCommission}"
                                                    Width="Auto" />

                                <DataGridTextColumn Header="Amount"
                                                    Binding="{Binding Amount}"
                                                    Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Calculated Totals Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Total Records, Total Material Weight -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Records"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding TotalRecords, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Total Material Weight"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding TotalMaterialWeight, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <!-- Row 2: Total Amount, Grand Total -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Amount"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding TotalAmount, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Grand Total"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding GrandTotal, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}"
                                 FontWeight="Bold" />
                    </Grid>
                </Border>

                <!-- Remarks -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Remarks"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Top"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="{StaticResource ExtraSmall}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{StaticResource Medium}">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />
                </StackPanel>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar Height="{StaticResource StandardControlHeight}"
                                   IsIndeterminate="True"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="{StaticResource Small}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
