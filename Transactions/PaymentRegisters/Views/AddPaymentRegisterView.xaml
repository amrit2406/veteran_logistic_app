<UserControl x:Class="veteran_logistic.Transactions.PaymentRegisters.Views.AddPaymentRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                Padding="{StaticResource Medium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Add Payment Register"
                           Style="{StaticResource HeadingTextBlockStyle}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Height="{StaticResource StandardControlHeight}"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Go Back"
                        VerticalAlignment="Center"
                        Margin="{StaticResource Small}">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource BackIconGeometry}"
                              Fill="{DynamicResource TextPrimaryBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Large}">
            <StackPanel>
                <!-- Validation Error -->
                <Border Background="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Small}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Challan Search -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Challan Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ChallanNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />
                        <Button Grid.Column="2"
                                Content="Load Challan Data"
                                Command="{Binding LoadChallanDataCommand}"
                                Height="{StaticResource StandardControlHeight}"
                                Margin="{StaticResource Small}"
                                MinWidth="120" />
                    </Grid>
                </Border>

                <!-- Auto-Populated Data (Read-Only) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding PaymentRegisterData, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Transaction Data (Auto-Populated from Loading &amp; Unloading Registers)"
                                   Style="{StaticResource SubHeadingTextBlockStyle}"
                                   Margin="{StaticResource Small}" />
                        
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: TP Number, Vehicle Number -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="TP Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding PaymentRegisterData.TPNumber, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Vehicle Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding PaymentRegisterData.VehicleNumber, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <!-- Row 2: Vehicle Type, Material -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vehicle Type"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding PaymentRegisterData.VehicleType, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Material"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding PaymentRegisterData.MaterialName, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <!-- Row 3: Loading Date, Unloading Date -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Loading Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding PaymentRegisterData.LoadingDate, StringFormat=dd-MM-yyyy, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Unloading Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding PaymentRegisterData.UnloadingDate, StringFormat=dd-MM-yyyy, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}"
                                 Background="{DynamicResource DisabledBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment Details Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding PaymentRegisterData, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Payment Date, Payment Location -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Payment Date"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <DatePicker Grid.Row="0" Grid.Column="1"
                                    SelectedDate="{Binding PaymentDate}"
                                    Height="{StaticResource StandardControlHeight}"
                                    Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Payment Location"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <ComboBox Grid.Row="0" Grid.Column="4"
                                  ItemsSource="{Binding PaymentLocations}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="PaymentLocationName"
                                  SelectedValue="{Binding PaymentLocationId}"
                                  Height="{StaticResource StandardControlHeight}"
                                  Margin="{StaticResource ExtraSmall}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="PaymentLocationName" />

                        <!-- Row 2: Payment Type, HSD Party -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Payment Type"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding PaymentType, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="HSD Party"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding HSDParty, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 3: TDS %, Challan Money -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TDS %"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding TDSPercentage, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Challan Money"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding ChallanMoney, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 4: Surcharge @ 2%, Admin Charge -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Surcharge @ 2%"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Surcharge, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Admin Charge"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="4"
                                 Text="{Binding AdminCharge, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />
                    </Grid>
                </Border>

                <!-- Beneficiary Details Grid -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding PaymentRegisterData, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Beneficiary Details"
                                   Style="{StaticResource SubHeadingTextBlockStyle}"
                                   Margin="{StaticResource Small}" />

                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Beneficiary, PAN -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Beneficiary"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Beneficiary, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="PAN"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding PAN, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 2: UTR Number, Mobile Number -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UTR Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding UTRNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Mobile Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 Text="{Binding MobileNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 3: Account Number, IFSC Code -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Account Number"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="IFSC Code"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding IFSCCode, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />

                        <!-- Row 4: Bank Name -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bank Name"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="{StaticResource StandardControlHeight}"
                                 Margin="{StaticResource ExtraSmall}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notes & Active -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding PaymentRegisterData, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Notes"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Top"
                                   Margin="{StaticResource ExtraSmall}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="{StaticResource ExtraSmall}"
                                 VerticalScrollBarVisibility="Auto" />

                        <CheckBox Grid.Row="0" Grid.Column="3"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center"
                                  Margin="{StaticResource ExtraSmall}" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Active"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Small}" />
                    </Grid>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{StaticResource Medium}"
                            Visibility="{Binding PaymentRegisterData, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Height="{StaticResource StandardControlHeight}"
                            Margin="{StaticResource Small}"
                            MinWidth="100" />
                </StackPanel>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="{StaticResource Medium}"
                        Margin="{StaticResource Small}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ProgressBar Height="{StaticResource StandardControlHeight}"
                                   IsIndeterminate="True"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="{StaticResource Small}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
